# readingtime.app.nz configuration. Copy to .env for local dev and fill in values.
# Everything below is read by the Go server unless noted. Anything the server
# cannot start without is marked REQUIRED.

# REQUIRED (postgres). User-authored stories, accounts, auth and billing all
# live here. The server exits at startup if this is unset.
DATABASE_URL=postgres://readingtime:changeme@127.0.0.1:5432/readingtime?sslmode=disable

# Port the Go server listens on (nginx readingtime.app.nz proxies here).
PORT=4337

# readingtime's own legacy SQLite DB for user-authored stories. It is imported
# into postgres on first boot and then left alone; safe to leave unset.
DB_PATH=readingtime.db

# Shared app.nz SSO/billing SQLite DB. Read-only here: the signed-in user is
# resolved from the appnz_session cookie -> sso_sessions. Same file papers shares.
APPNZ_DATABASE_PATH=/nvme0n1-disk/data/appnz-sso.db

# Local app.nz OpenAI-compatible AI gateway (story text + page images). The
# user's session cookie is forwarded so spend is metered to their app.nz credits.
GATEWAY_URL=http://127.0.0.1:8787
# Optional service key, for server-to-server calls that are not tied to a user.
GATEWAY_SERVICE_KEY=

# Where the "Sign in" button sends users (app.nz sets the shared .app.nz cookie).
APPNZ_LOGIN_URL=https://app.nz/login
APPNZ_ACCOUNT_URL=https://app.nz/account
SITE_BASE_URL=https://readingtime.app.nz

# Parent domain the shared app.nz session cookie is scoped to. /logout expires
# this cookie to sign the user out across every *.app.nz subdomain. Must match
# app-site's COOKIE_DOMAIN.
COOKIE_DOMAIN=.app.nz

# Cloudflare R2 object storage. Uploaded story art is written here and served
# from R2_PUBLIC_BASE. Leave the credentials blank to keep uploads local to
# static/generated/ instead.
READINGTIME_R2_ACCESS_KEY_ID=
READINGTIME_R2_SECRET_ACCESS_KEY=
READINGTIME_R2_BUCKET=
READINGTIME_R2_ENDPOINT=
READINGTIME_R2_PUBLIC_BASE=

# Public CDN origin for /static assets. When set, templates rewrite asset URLs
# to this host with a build-version query string. Blank serves from this origin.
STATIC_BASE_URL=

# Google Gemini, used for text-to-speech narration. Either key name works.
READINGTIME_TTS_PROVIDER=
READINGTIME_TTS_VOICE=
READINGTIME_TTS_LANG=
READINGTIME_GEMINI_VOICE=
READINGTIME_GEMINI_TTS_MODEL=
READINGTIME_TTS_RATE=
READINGTIME_GEMINI_API_KEY=
READINGTIME_GOOGLE_CREDENTIALS=
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Stripe. Without STRIPE_SECRET_KEY the checkout buttons are disabled and the
# server logs "checkout disabled" at startup; everything else still works.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

DEBUG=false
DEV=false

# Cloudflare, read by deploy.sh only (to purge the CDN cache after a deploy).
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=
CLOUDFLARE_ZONE_APP_NZ=