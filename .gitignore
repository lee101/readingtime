node_modules*

# compiled server binary
/readingtime

# local data + secrets
.env
readingtime.db
readingtime.db-*

# Python bytecode from the art scripts
__pycache__/
*.pyc

# user-generated content (AI page art saved when a provider returns base64)
static/generated/
static/manuscript-pages/

# AI-generated cover art (regenerate with scripts/generate_manuscript_covers.py)
static/manuscript-covers/

# Generated manuscript cover art. Regenerate with
# scripts/generate_manuscript_covers.py; the manuscripts/*.md files link to
# these by relative path, so a fresh clone has no artwork until you do.
manuscripts/art/
# visual regression screenshots (generated by visualbench tooling)
visualbench/

# incremental static-sync bookkeeping used by deploy.sh
.deploy-state/